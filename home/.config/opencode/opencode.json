{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "architect",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "provider": {
    "llama.cpp (local - cipher - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local - cipher - stable)",
      "options": {
        "baseURL": "http://localhost:8081/v1"
      },
      "models": {
        "jzaleski/cipher": {
          "name": "cipher",
          "limit": {
            "context": 81920,
            "input": 73728,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (local - sage - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local - sage - stable)",
      "options": {
        "baseURL": "http://localhost:8082/v1"
      },
      "models": {
        "jzaleski/sage": {
          "name": "sage",
          "limit": {
            "context": 81920,
            "input": 73728,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (server - cipher - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (server - cipher - stable)",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8081/v1"
      },
      "models": {
        "jzaleski/cipher": {
          "name": "cipher",
          "limit": {
            "context": 196608,
            "input": 163840,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (server - sage - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (server - sage - stable)",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8082/v1"
      },
      "models": {
        "jzaleski/sage": {
          "name": "sage",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    }
  }
}
