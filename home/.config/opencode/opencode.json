{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "engineer",
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "provider": {
    "llama.cpp (local - jzaleski/cipher)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local - jzaleski/cipher)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "jzaleski/cipher": {
          "name": "jzaleski/cipher",
          "limit": {
            "context": 81920,
            "input": 73728,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "llama.cpp (local - jzaleski/sage)": {
