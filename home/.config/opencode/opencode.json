{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "architect",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "provider": {
    "llama.cpp (local - advisor - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local - advisor - stable)",
      "options": {
        "baseURL": "http://localhost:8082/v1"
      },
      "models": {
        "jzaleski/advisor": {
          "name": "advisor",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (local - coder - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local - coder - stable)",
      "options": {
        "baseURL": "http://localhost:8081/v1"
      },
      "models": {
        "jzaleski/coder": {
          "name": "coder",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (server - advisor - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (server - advisor - stable)",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8082/v1"
      },
      "models": {
        "jzaleski/advisor": {
          "name": "advisor",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (server - coder - stable)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (server - coder - stable)",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8081/v1"
      },
      "models": {
        "jzaleski/coder": {
          "name": "coder",
          "limit": {
            "context": 196608,
            "input": 163840,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
