  "plugin": [],
  "mcp": {
    "aws-api": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "AWS_PROFILE=YOUR_AWS_PROFILE AWS_REGION=YOUR_AWS_REGION exec uvx awslabs.aws-api-mcp-server@latest"
      ],
      "enabled": false
    },
    "gcloud": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": {},
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    }
  }
}
