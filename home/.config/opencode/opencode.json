{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "engineer",
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "provider": {
    "llama.cpp (local) (default)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local) (default)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "jzaleski/default/low": {
          "name": "jzaleski/default/low",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/low-multimodal": {
          "name": "jzaleski/default/low-multimodal",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/medium": {
          "name": "jzaleski/default/medium",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
