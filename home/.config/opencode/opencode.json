{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "engineer",
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "provider": {
    "local-multi": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "local-multi",
      "settings": {
        "baseURL": "http://server-hostname-or-ip:8081/v1"
      },
      "models": {
        "jzaleski/multi": {
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"],
            "tools": true
          }
        }
      }
    },
    "local-text": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "local-text",
      "settings": {
        "baseURL": "http://server-hostname-or-ip:8082/v1"
      },
      "models": {
        "jzaleski/text": {
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "capabilities": {
            "input": ["text"],
            "output": ["text"],
            "tools": true
          }
        }
      }
    }
  },
  "plugins": [
    {
      "package": "./plugins/model-curator",
      "options": {
        "allowlists": {
          "amazon-bedrock": [],
          "google-vertex": []
        },
        "alphabetize": true,
        "labels": {
          "amazon-bedrock": "Bedrock",
          "google-vertex": "Vertex AI",
          "local-multi": "Local",
          "local-text": "Local"
        },
        "stripRegion": true
      }
    }
  ],
  "mcp": {
    "servers": {
      "aws": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.YOUR_AWS_REGION.api.aws/mcp",
          "--metadata", "AWS_REGION=YOUR_AWS_REGION",
          "--profile", "YOUR_AWS_PROFILE"
        ],
        "disabled": true
      },
      "gcloud": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@google-cloud/gcloud-mcp"
        ],
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      },
      "jira": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
        "disabled": true
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com/v1/mcp",
        "disabled": true
      }
    }
  }
}
