{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "engineer",
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "provider": {
    "llama.cpp (local)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "jzaleski/low": {
          "name": "jzaleski/low",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/low-multimodal": {
          "name": "jzaleski/low-multimodal",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "jzaleski/medium": {
          "name": "jzaleski/medium",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/medium-multimodal": {
          "name": "jzaleski/medium-multimodal",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "jzaleski/high": {
          "name": "jzaleski/high",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/high-multimodal": {
          "name": "jzaleski/high-multimodal",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp (server)": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (server)",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8080/v1"
      },
      "models": {
        "jzaleski/low": {
          "name": "jzaleski/low",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/low-multimodal": {
          "name": "jzaleski/low-multimodal",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "jzaleski/medium": {
          "name": "jzaleski/medium",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/medium-multimodal": {
          "name": "jzaleski/medium-multimodal",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "jzaleski/high": {
          "name": "jzaleski/high",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "jzaleski/high-multimodal": {
          "name": "jzaleski/high-multimodal",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "plugin": [],
  "mcp": {
    "aws-api": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "AWS_PROFILE=YOUR_AWS_PROFILE AWS_REGION=YOUR_AWS_REGION exec uvx awslabs.aws-api-mcp-server@latest"
      ],
      "enabled": false
    },
    "gcloud": {
      "type": "local",
      "command": ["npx", "-y", "@google-cloud/gcloud-mcp"],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": {},
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    }
  }
}
