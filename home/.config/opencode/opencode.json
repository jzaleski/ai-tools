{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "engineer",
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "provider": {
    "jzaleski/default": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "jzaleski/default",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8080/v1"
      },
      "models": {
        "jzaleski/default/low": {
          "name": "Low",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/low-multimodal": {
          "name": "Low (Multimodal)",
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/medium": {
          "name": "Medium",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/medium-multimodal": {
          "name": "Medium (Multimodal)",
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/high": {
          "name": "High",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/default/high-multimodal": {
          "name": "High (Multimodal)",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "jzaleski/experimental": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "jzaleski/experimental",
      "options": {
        "baseURL": "http://server-hostname-or-ip:8081/v1"
      },
      "models": {
        "jzaleski/experimental/quark": {
          "name": "Quark",
          "limit": {
            "context": 1048576,
            "input": 917504,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "jzaleski/experimental/boson": {
          "name": "Boson",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "plugin": [],
  "mcp": {
    "aws": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.YOUR_AWS_REGION.api.aws/mcp",
        "--metadata", "AWS_REGION=YOUR_AWS_REGION",
        "--profile", "YOUR_AWS_PROFILE"
      ],
      "enabled": false
    },
    "gcloud": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": {},
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com/v1/mcp",
      "enabled": false,
      "oauth": {}
    }
  }
}
