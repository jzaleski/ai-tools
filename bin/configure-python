#!/usr/bin/env bash

set -e;

cd $(dirname $0)/..;

# Check if user wants to use an existing version manager
if [ "$USE_EXISTING_PYTHON_MANAGER" = "true" ]; then
  echo "USE_EXISTING_PYTHON_MANAGER is set to true, skipping pyenv setup";
  exit 0;
fi

# Detect existing Python version managers
if command -v asdf &> /dev/null && asdf plugin list 2>/dev/null | grep -q python; then
  echo "Warning: Detected existing asdf with python plugin";
  echo "   To use asdf instead of pyenv, set: USE_EXISTING_PYTHON_MANAGER=true";
  echo "   Continuing with pyenv setup...";
  echo "";
fi

dot_opencoderc_file="$HOME/.opencoderc";
if [ -e "$dot_opencoderc_file" ]; then
  source "$dot_opencoderc_file";
fi

cat_cmd=$(which cat 2> /dev/null || echo -n);
if [ -z "$cat_cmd" ]; then
  echo "❌ Error: Could not locate the \"cat\" command" >&2;
  exit 1;
fi

git_cmd=$(which git 2> /dev/null || echo -n);
if [ -z "$git_cmd" ]; then
  echo "❌ Error: Could not locate the \"git\" command" >&2;
  exit 1;
fi

pyenv_dir="$HOME/.pyenv";
if [ ! -e "$pyenv_dir" ]; then
  "${git_cmd}" clone https://github.com/pyenv/pyenv.git "${pyenv_dir}";
elif [ -e "$pyenv_dir/.git" ]; then
  (cd "${pyenv_dir}" && "${git_cmd}" pull);
fi

pyenv_plugins_dir="$pyenv_dir/plugins";
mkdir -p "${pyenv_plugins_dir}";

pyenv_versions_dir="$pyenv_dir/versions";
mkdir -p "${pyenv_versions_dir}";

if [ -e "$dot_opencoderc_file" ]; then
  source "$dot_opencoderc_file";
fi

pyenv_cmd=$(which pyenv 2> /dev/null || echo -n);
if [ -z "$pyenv_cmd" ] && [ -x "$HOME/.pyenv/bin/pyenv" ]; then
  pyenv_cmd="$HOME/.pyenv/bin/pyenv";
fi
if [ -z "$pyenv_cmd" ]; then
  echo "❌ Error: Could not locate the \"pyenv\" command" >&2;
  exit 1;
fi

default_python_version=$(${cat_cmd} "$(dirname "$0")/../.default-python-version");
python_versions=("${default_python_version}");

for python_version in "${python_versions[@]}"; do
  "${pyenv_cmd}" install -s "${python_version}";
done

"${pyenv_cmd}" global "${default_python_version}";
"${pyenv_cmd}" rehash;

"${pyenv_cmd}" exec pip install -r "$(dirname "$0")/../requirements.txt";
