#!/usr/bin/env bash

set -e;

run_local() {
  exec llama-server \
    -hf                unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_XL \
    --alias            jzaleski/local \
    --host             127.0.0.1 \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         81920 \
    --cache-type-k     q4_0 \
    --cache-type-v     q4_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

run_local_experimental() {
  exec llama-server \
    -hf                Jackrong/Qwopus3.6-35B-A3B-v1-GGUF:Q4_K_M \
    --alias            jzaleski/local \
    --host             127.0.0.1 \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         81920 \
    --cache-type-k     q4_0 \
    --cache-type-v     q4_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

experimental=false;
for arg in "$@"; do
  case "${arg}" in
    --experimental) experimental=true;;
  esac
done

if [[ "${experimental}" == "true" ]]; then
  run_local_experimental;
else
  run_local;
fi
