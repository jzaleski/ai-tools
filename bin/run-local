#!/usr/bin/env bash

set -e;

MODELS_DIR="${HOME}/.cache/models";

require_model() {
  local model_file="${1}";
  if [[ ! -f "${model_file}" ]]; then
    echo "Error: model file not found: ${model_file}" >&2;
    echo "Run 'bin/download-models' to download all models, or" >&2;
    echo "     'bin/download-models --local' / '--local-experimental' for just this one." >&2;
    exit 1;
  fi
}

run_local() {
  local model="${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf";
  require_model "${model}";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/local \
    --host             127.0.0.1 \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         81920 \
    --cache-type-k     q4_0 \
    --cache-type-v     q4_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

run_local_experimental() {
  local model="${MODELS_DIR}/Jackrong/Qwopus3.6-35B-A3B-v1-Q4_K_M.gguf";
  require_model "${model}";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/local \
    --host             127.0.0.1 \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         81920 \
    --cache-type-k     q4_0 \
    --cache-type-v     q4_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

# Prevent inherited environment from accidentally enabling router mode.
unset LLAMA_ARG_MODELS_DIR LLAMA_ARG_MODELS_PRESET;

experimental=false;
for arg in "$@"; do
  case "${arg}" in
    --experimental) experimental=true;;
  esac
done

if [[ "${experimental}" == "true" ]]; then
  run_local_experimental;
else
  run_local;
fi
