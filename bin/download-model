#!/usr/bin/env bash

# download-model <hf-repo> <hf-filename> [local-filename] [--force]
#
# Downloads a single GGUF file from Hugging Face directly via curl.
# Skips the download if the file already exists unless --force is passed, in
# which case the existing file is deleted first.
#
# The provider (first component of hf-repo) is used as a subdirectory, so
# e.g. unsloth/Qwen3.6-35B-A3B-GGUF downloads into <MODELS_DIR>/unsloth/.
#
# Arguments (positional, in order):
#   hf-repo         e.g. unsloth/Qwen3.6-35B-A3B-GGUF
#   hf-filename     e.g. Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf (used to build the
#                   download URL)
#   local-filename  optional; the filename to save under (default:
#                   hf-filename). Use this to disambiguate two repos under
#                   the same provider that happen to ship identically-named
#                   files (e.g. an MTP repo vs. its non-MTP counterpart) —
#                   without it, the existence check below can't tell the
#                   two repos' files apart and will wrongly skip a real
#                   download because a same-named file from a *different*
#                   repo already exists at that path.
#
# Flags:
#   --force      delete the existing file and re-download
#
# Environment variables:
#   HF_TOKEN     Hugging Face API token for gated/private models (optional)
#   MODELS_DIR   root directory for model storage (default: ~/.cache/models)

set -e;

usage() {
  echo "Usage: $(basename "$0") <hf-repo> <hf-filename> [local-filename] [--force]" >&2;
  exit 1;
}

if [[ $# -lt 2 ]]; then
  usage;
fi

hf_repo="${1}";
hf_filename="${2}";
local_filename="${hf_filename}";
provider="${hf_repo%%/*}";
dest_path="${MODELS_DIR:-"${HOME}/.cache/models"}/${provider}";
# hf_filename may include a subdirectory (e.g. "UD-Q8_K_XL/file-00001-of-00006.gguf");
# preserve that structure under dest_path unless local-filename overrides it.
force=false;

for arg in "${@:3}"; do
  case "${arg}" in
    --force) force=true;;
    --*) echo "Unknown flag: ${arg}" >&2; usage;;
    *) local_filename="${arg}";;
  esac
done

if [[ "${local_filename}" == /* ]]; then
  dest_file="${local_filename}";
else
  dest_file="${dest_path}/${local_filename}";
fi

if [[ "${force}" == "true" ]] && [[ -f "${dest_file}" ]]; then
  echo "Removing existing file: ${dest_file}";
  rm -f "${dest_file}";
fi

if [[ -f "${dest_file}" ]]; then
  echo "Already exists, skipping: ${dest_file}";
  exit 0;
fi

if ! command -v curl &>/dev/null; then
  echo "Error: curl not found." >&2;
  exit 1;
fi

mkdir -p "$(dirname "${dest_file}")";

url="https://huggingface.co/${hf_repo}/resolve/main/${hf_filename}";

curl_args=(-L --fail --progress-bar -o "${dest_file}");
if [[ -n "${HF_TOKEN:-}" ]]; then
  curl_args+=(-H "Authorization: Bearer ${HF_TOKEN}");
fi

echo "Downloading ${url} -> ${dest_file}";
if ! curl "${curl_args[@]}" "${url}"; then
  echo "Error: download failed (HTTP error or network issue). Removing partial file." >&2;
  rm -f "${dest_file}";
  exit 1;
fi

echo "Done: ${dest_file}";
