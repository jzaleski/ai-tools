#!/usr/bin/env bash

set -e;

MODELS_DIR="${HOME}/.cache/models";

require_model() {
  local model_file="${1}";
  local hf_repo="${2}";
  if [[ ! -f "${model_file}" ]]; then
    local hf_filename;
    hf_filename="$(basename "${model_file}")";
    echo "Model not found: ${model_file}";
    echo "Downloading ${hf_repo}/${hf_filename} ...";
    "$(dirname "$0")/download-model" "${hf_repo}" "${hf_filename}" || {
      echo "Error: download failed." >&2;
      exit 1;
    };
  fi
}

run_server() {
  local model="${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf";
  require_model "${model}" "unsloth/Qwen3.6-35B-A3B-GGUF";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/server \
    --host             0.0.0.0 \
    --port             "${PORT:-"8080"}" \
    --log-file         - \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       4096 \
    --ubatch-size      1024 \
    --ctx-size         262144 \
    --cache-type-k     q8_0 \
    --cache-type-v     q8_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

run_server_experimental() {
  local model="${MODELS_DIR}/Jackrong/Qwopus3.6-35B-A3B-v1-Q8_0.gguf";
  require_model "${model}" "Jackrong/Qwopus3.6-35B-A3B-v1-GGUF";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/server \
    --host             0.0.0.0 \
    --port             "${PORT:-"8080"}" \
    --log-file         - \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       4096 \
    --ubatch-size      1024 \
    --ctx-size         262144 \
    --cache-type-k     q8_0 \
    --cache-type-v     q8_0 \
    --presence-penalty 1.5 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

# Prevent inherited environment from accidentally enabling router mode.
unset LLAMA_ARG_MODELS_DIR LLAMA_ARG_MODELS_PRESET;

experimental=false;
for arg in "$@"; do
  case "${arg}" in
    --experimental) experimental=true;;
  esac
done

if [[ "${experimental}" == "true" ]]; then
  run_server_experimental;
else
  run_server;
fi
