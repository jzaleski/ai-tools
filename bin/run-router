#!/usr/bin/env bash

set -e;

TEMPLATES_DIR="$(dirname "$0")/../templates";
TMP_DIR="$(dirname "$0")/../tmp";
MODELS_DIR="${MODELS_DIR:-"$HOME/.cache/models"}";

find_binary() {
  local bin_name="${1}";
  local local_bin="${HOME}/src/ggml-org/llama.cpp/build/bin/${bin_name}";
  if [[ -x "${local_bin}" ]]; then
    echo "${local_bin}";
  elif command -v "${bin_name}" >/dev/null 2>&1; then
    command -v "${bin_name}";
  else
    echo "${bin_name}";
  fi
}

LLAMA_SERVER="${LLAMA_SERVER:-"$(find_binary llama-server)"}";

# Download a required file via download-model if it is not already present.
# Args: <local-path> <hf-repo> [hf-filename]
# hf-filename defaults to the basename of <local-path>.
require_model() {
  local model_file="${1}";
  local hf_repo="${2}";
  local hf_filename="${3:-"$(basename "${model_file}")"}";
  if [[ ! -f "${model_file}" ]]; then
    echo "Model not found: ${model_file}";
    echo "Downloading ${hf_repo}/${hf_filename} -> ${model_file} ...";
    # Pass model_file as the explicit local filename so download-model
    # saves directly under the exact absolute path requested. This enables
    # both disambiguated local names (e.g. a "-MTP-" infix) and custom
    # directory structures (e.g. provider/repo/file.gguf) regardless of
    # the remote path structure.
    "$(dirname "$0")/download-model" "${hf_repo}" "${hf_filename}" "${model_file}" || {
      echo "Error: download failed." >&2;
      exit 1;
    };
  fi
}

# Ensure the F16 multimodal projector for a model exists, downloading it if
# missing.  Derives the local mmproj path from the model file (same name with a
# .mmproj extension instead of .gguf) and pulls the repo's shared mmproj-F16.gguf.
# Args: <model-file> <hf-repo>
require_mmproj() {
  local model_file="${1}";
  local hf_repo="${2}";
  local mmproj_file="${model_file%.gguf}.mmproj";
  require_model "${mmproj_file}" "${hf_repo}" "mmproj-F16.gguf";
}

# Ensure every model and mmproj file referenced by the router preset exists,
# downloading any that are missing.  Mirrors the per-tier definitions in
# bin/run-model and the sections in templates/llama-cpp.ini.template.
#
# The router serves 6 aliases: fast/no-vision MTP tiers (low, medium, high)
# and vision-capable tiers (low-multimodal, medium-multimodal, high-multimodal).
require_models() {
  local repo_qwen38="unsloth/Qwen3.8-27B-GGUF";

  # Fast/no-vision tiers (low, medium, high) run with --spec-type draft-mtp 
  # speculative decoding. llama.cpp does not yet support combining --mmproj 
  # with MTP speculative decoding, so no multimodal projector is downloaded 
  # for them. Vision-capable tiers (low-multimodal, medium-multimodal, 
  # high-multimodal) use the identical model weights but without MTP enabled,
  # and add the shared F16 multimodal projector.
  require_model  "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q4_K_XL.gguf" "${repo_qwen38}";
  require_mmproj "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q4_K_XL.gguf" "${repo_qwen38}";

  require_model  "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q6_K_XL.gguf" "${repo_qwen38}";
  require_mmproj "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q6_K_XL.gguf" "${repo_qwen38}";

  require_model  "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q8_K_XL.gguf" "${repo_qwen38}";
  require_mmproj "${MODELS_DIR}/unsloth/Qwen3.8-27B-UD-Q8_K_XL.gguf" "${repo_qwen38}";
}

# Expand template tokens in a preset INI file and write the rendered result to
# the sibling tmp/ directory, deriving the output filename by stripping the
# .template suffix from the template basename.  Prints the output path to stdout.
render_preset() {
  local template="$1";
  local out="${TMP_DIR}/$(basename "${template%.template}")";
  mkdir -p "${TMP_DIR}";
  sed "s|MODELS_DIR|${MODELS_DIR}|g" "${template}" > "${out}";
  echo "${out}";
}

require_experimental_models() {
  # quark: DeepSeek-V4-Flash
  require_split_model "${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-UD-Q4_K_XL.gguf" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "UD-Q4_K_XL/DeepSeek-V4-Flash-0731-UD-Q4_K_XL.gguf" 5;
  require_model "${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf";

  # boson: Qwen3.8-Flash-Next
  require_split_model "${MODELS_DIR}/unsloth/Qwen3.8-Flash-Next-GGUF/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL.gguf" "unsloth/Qwen3.8-Flash-Next-GGUF" "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL.gguf" 4;

  # gluon: GLM-5.3-Flash (text-only; see bin/run-model's run_experimental_gluon
  # comment for the llama.cpp-fork caveat and omitted-speculative-decoding rationale)
  require_split_model "${MODELS_DIR}/unsloth/GLM-5.3-Flash-GGUF/UD-Q4_K_XL/GLM-5.3-Flash-UD-Q4_K_XL.gguf" "unsloth/GLM-5.3-Flash-GGUF" "UD-Q4_K_XL/GLM-5.3-Flash-UD-Q4_K_XL.gguf" 6;
}

# Ensure all parts of a split GGUF model exist, downloading them if missing.
# Args: <base-model-file> <hf-repo> <hf-base-filename> [num-parts]
require_split_model() {
  local base_model_file="${1}";
  local hf_repo="${2}";
  local hf_base_filename="${3}";
  local num_parts="${4:-1}";

  if [[ "${num_parts}" -eq 1 ]]; then
    require_model "${base_model_file}" "${hf_repo}" "${hf_base_filename}";
    return 0;
  fi

  local local_dir="$(dirname "${base_model_file}")";
  local local_base="$(basename "${base_model_file}" .gguf)";
  local hf_dir="$(dirname "${hf_base_filename}")";
  local hf_base="$(basename "${hf_base_filename}" .gguf)";
  
  if [[ "${hf_dir}" == "." ]]; then
    hf_dir="";
  else
    hf_dir="${hf_dir}/";
  fi

  local i;
  for ((i=1; i<=num_parts; i++)); do
    local part_suffix;
    part_suffix=$(printf -- "-%05d-of-%05d.gguf" "${i}" "${num_parts}");
    require_model "${local_dir}/${local_base}${part_suffix}" "${hf_repo}" "${hf_dir}${hf_base}${part_suffix}";
  done
}

main() {
  local mode="default";
  for arg in "$@"; do
    case "${arg}" in
      --experimental) mode="experimental";;
      --default)      mode="default";;
    esac
  done

  local preset_file;
  local default_port;

  if [[ "${mode}" == "experimental" ]]; then
    require_experimental_models;
    preset_file="${TEMPLATES_DIR}/llama-cpp-experimental.ini.template";
    default_port="8081";
  else
    require_models;
    preset_file="${TEMPLATES_DIR}/llama-cpp-default.ini.template";
    default_port="8080";
  fi

  local preset;
  preset="$(render_preset "${preset_file}")";
  
  exec "${LLAMA_SERVER}" \
    --host "${HOST:-"127.0.0.1"}" \
    --port "${PORT:-"${default_port}"}" \
    --models-preset "${preset}";
}

main "$@";
