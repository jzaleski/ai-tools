#!/usr/bin/env bash

set -e;

CONF_DIR="$(dirname "$0")/../conf";

run_local() {
  exec llama-server \
    --host "${HOST:-"127.0.0.1"}" \
    --port "${PORT:-"8080"}" \
    --models-preset "${CONF_DIR}/llama-cpp-local.ini";
}

run_local_experimental() {
  exec llama-server \
    --host "${HOST:-"127.0.0.1"}" \
    --port "${PORT:-"8080"}" \
    --models-preset "${CONF_DIR}/llama-cpp-local-experimental.ini";
}

run_server() {
  exec llama-server \
    --host "${HOST:-"0.0.0.0"}" \
    --port "${PORT:-"8080"}" \
    --models-preset "${CONF_DIR}/llama-cpp-server.ini";
}

run_server_experimental() {
  exec llama-server \
    --host "${HOST:-"0.0.0.0"}" \
    --port "${PORT:-"8080"}" \
    --models-preset "${CONF_DIR}/llama-cpp-server-experimental.ini";
}

server=false;
experimental=false;
for arg in "$@"; do
  case "${arg}" in
    --server)       server=true;;
    --experimental) experimental=true;;
  esac
done

if [[ "${experimental}" == "true" ]]; then
  if [[ "${server}" == "true" ]]; then
    run_server_experimental;
  else
    run_local_experimental;
  fi
else
  if [[ "${server}" == "true" ]]; then
    run_server;
  else
    run_local;
  fi
fi
