#!/usr/bin/env bash

set -e;

TEMPLATES_DIR="$(dirname "$0")/../templates";
TMP_DIR="$(dirname "$0")/../tmp";
MODELS_DIR="${MODELS_DIR:-"$HOME/.cache/models"}";

# Download a required file via download-model if it is not already present.
# Args: <local-path> <hf-repo> [hf-filename]
# hf-filename defaults to the basename of <local-path>.
require_model() {
  local model_file="${1}";
  local hf_repo="${2}";
  local hf_filename="${3:-"$(basename "${model_file}")"}";
  if [[ ! -f "${model_file}" ]]; then
    echo "Model not found: ${model_file}";
    echo "Downloading ${hf_repo}/${hf_filename} ...";
    "$(dirname "$0")/download-model" "${hf_repo}" "${hf_filename}" || {
      echo "Error: download failed." >&2;
      exit 1;
    };
    # download-model stores under the remote basename; rename to the desired
    # local name if they differ (e.g. a shared mmproj-F16.gguf kept per-family).
    local downloaded="$(dirname "${model_file}")/$(basename "${hf_filename}")";
    if [[ "${downloaded}" != "${model_file}" ]] && [[ -f "${downloaded}" ]]; then
      mv "${downloaded}" "${model_file}";
    fi
  fi
}

# Ensure the F16 multimodal projector for a model exists, downloading it if
# missing.  Derives the local mmproj path from the model file (same name with a
# .mmproj extension instead of .gguf) and pulls the repo's shared mmproj-F16.gguf.
# Args: <model-file> <hf-repo>
require_mmproj() {
  local model_file="${1}";
  local hf_repo="${2}";
  local mmproj_file="${model_file%.gguf}.mmproj";
  require_model "${mmproj_file}" "${hf_repo}" "mmproj-F16.gguf";
}

# Ensure every model and mmproj file referenced by the router preset exists,
# downloading any that are missing.  Mirrors the per-tier definitions in
# bin/run-model and the sections in templates/llama-cpp.ini.template.
require_models() {
  local repo_qwen36="unsloth/Qwen3.6-35B-A3B-GGUF";
  local repo_gemma4="unsloth/gemma-4-31B-it-GGUF";
  # 35B-A3B tiers (low uses Q4_K_XL, medium uses Q6_K_XL); the multimodal
  # projector is the same F16 file, stored per-model alongside each .gguf.
  require_model  "${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf" "${repo_qwen36}";
  require_mmproj "${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf" "${repo_qwen36}";
  require_model  "${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf" "${repo_qwen36}";
  require_mmproj "${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf" "${repo_qwen36}";
  # high tier (gemma) + its multimodal projector
  require_model  "${MODELS_DIR}/unsloth/gemma-4-31B-it-UD-Q8_K_XL.gguf" "${repo_gemma4}";
  require_mmproj "${MODELS_DIR}/unsloth/gemma-4-31B-it-UD-Q8_K_XL.gguf" "${repo_gemma4}";
}

# Expand template tokens in a preset INI file and write the rendered result to
# the sibling tmp/ directory, deriving the output filename by stripping the
# .template suffix from the template basename.  Prints the output path to stdout.
render_preset() {
  local template="$1";
  local out="${TMP_DIR}/$(basename "${template%.template}")";
  mkdir -p "${TMP_DIR}";
  sed "s|MODELS_DIR|${MODELS_DIR}|g" "${template}" > "${out}";
  echo "${out}";
}

main() {
  local preset;
  require_models;
  preset="$(render_preset "${TEMPLATES_DIR}/llama-cpp.ini.template")";
  exec llama-server \
    --host "${HOST:-"127.0.0.1"}" \
    --port "${PORT:-"8080"}" \
    --models-preset "${preset}";
}

main;
