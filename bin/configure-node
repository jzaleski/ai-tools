#!/usr/bin/env bash

set -e;

cd $(dirname $0)/..;

cat_cmd=$(which cat 2> /dev/null || echo -n);
if [ -z "$cat_cmd" ]; then
  echo "Error: Could not locate the \"cat\" command" >&2;
  exit 1;
fi

git_cmd=$(which git 2> /dev/null || echo -n);
if [ -z "$git_cmd" ]; then
  echo "Error: Could not locate the \"git\" command" >&2;
  exit 1;
fi

nodenv_dir="$HOME/.nodenv";
if [ ! -e "$nodenv_dir" ]; then
  ${git_cmd} clone https://github.com/nodenv/nodenv.git "$nodenv_dir";
elif [ -e "$nodenv_dir/.git" ]; then
  (cd "$nodenv_dir" && ${git_cmd} pull);
fi

nodenv_plugins_dir="$nodenv_dir/plugins";
mkdir -p "$nodenv_plugins_dir";

nodenv_versions_dir="$nodenv_dir/versions";
mkdir -p "$nodenv_versions_dir";

node_build_dir="$nodenv_plugins_dir/node-build";
if [ ! -e "$node_build_dir" ]; then
  ${git_cmd} clone https://github.com/nodenv/node-build.git "$node_build_dir";
elif [ -e "$node_build_dir/.git" ]; then
  (cd "$node_build_dir" && ${git_cmd} pull);
fi

nodenv_bin_dir="$nodenv_dir/bin";
if [[ ! "$PATH" =~ "$nodenv_bin_dir" ]]; then
  export PATH="$nodenv_bin_dir:$PATH";
fi

nodenv_shims_dir="$nodenv_dir/shims";
if [[ ! "$PATH" =~ "$nodenv_shims_dir" ]]; then
  export PATH="$nodenv_shims_dir:$PATH";
fi

nodenv_cmd=$(which nodenv 2> /dev/null || echo -n);
if [ -z "$nodenv_cmd" ]; then
  echo "Error: Could not locate the \"nodenv\" command" >&2;
  exit 1;
fi

default_node_version=$(${cat_cmd} .default-node-version);
node_versions=($default_node_version);

for node_version in ${node_versions[@]}; do
  ${nodenv_cmd} install -s ${node_version};
done

${nodenv_cmd} global "$default_node_version";
${nodenv_cmd} rehash;

npm_cmd=$(which npm 2> /dev/null || echo -n);
if [ -z "$npm_cmd" ]; then
  echo "Error: Could not locate the \"npm\" command" >&2;
  exit 1;
fi

default_npm_version=$(${cat_cmd} .default-npm-version);
installed_npm_version=$(${npm_cmd} -v 2> /dev/null || echo -n);

if [ "$default_npm_version" != "$installed_npm_version" ]; then
  ${npm_cmd} install -g "npm@$default_npm_version";
  ${nodenv_cmd} rehash;
fi
