# Experimental tier: DeepSeek-V4-Flash-0731 with DSpark speculative decoding.
# Note on naming: "DSpark" is DeepSeek's proprietary speculative decoding algorithm
# (DeepSeek Spark), completely unrelated to Apache Spark. It functions similarly to
# MTP but is optimized for V4, yielding ~1.5x-2x faster inference.
#
# Settings below follow Unsloth's DeepSeek-V4-Flash-0731 guide
# (https://unsloth.ai/docs/models/deepseek-v4):
# - Context is set to the model's stated maximum (1,048,576 / "1M"). Sized for
#   a dedicated M3 Ultra Mac Studio (512GB unified memory): UD-Q4_K_XL + the
#   DSpark drafter total ~172GB per Unsloth's own hardware table, leaving
#   ~340GB of headroom for the KV cache. DeepSeek-V4 uses MLA (Multi-head
#   Latent Attention), which compresses the per-token KV cache footprint far
#   below a standard dense-attention model, so even 1M tokens of context fits
#   comfortably in that headroom without needing hundreds more GB of RAM.
# - `top-p 0.95` is Unsloth's agentic-scenario recommendation for
#   DeepSeek-V4-Flash-0731 (general/non-agentic use recommends `1.0` instead);
#   this tier is used for agentic coding/tool-calling, so 0.95 applies.
# - `min-p 0.01` matches every llama.cpp invocation shown in Unsloth's guide
#   (including the DSpark example), even though it isn't called out in their
#   prose "Recommended Settings" table alongside temp/top-p.
# - `top-k` is intentionally omitted: none of Unsloth's DeepSeek-V4 examples
#   pass it, so this tier relies on llama-server's built-in default rather
#   than reusing the `20` tuned for Qwen3.8's separate sampling profile.
# - `--spec-draft-n-max 3` is already Unsloth's documented "good default" for
#   DSpark (~1.9x faster; larger values measured slower) — unchanged here.
run_experimental_quark() {
  local base_model="${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-UD-Q4_K_XL.gguf";
  local drafter_model="${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf";

  require_split_model "${base_model}" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "UD-Q4_K_XL/DeepSeek-V4-Flash-0731-UD-Q4_K_XL.gguf" 5;
  require_model "${drafter_model}" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf";

  local first_part="${base_model%.gguf}-00001-of-00005.gguf";

  exec "${LLAMA_SERVER}" \
    --model            "${first_part}" \
    --spec-draft-model "${drafter_model}" \
    --alias            jzaleski/experimental/quark \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8081"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       1024 \
    --ubatch-size      256 \
    --ctx-size         1048576 \
    --cache-type-k     q8_0 \
    --cache-type-v     q8_0 \
    --spec-type        draft-dspark \
    --spec-draft-n-max 3 \
    --chat-template-kwargs '{"reasoning_effort":"high"}' \
    --reasoning-preserve \
    --cache-reuse      256 \
    --cache-ram        -1 \
    --load-mode        mlock \
    --predict          262144 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.01 \
    --temp             1.0 \
    --top-p            0.95;
}

run_experimental_boson() {
  local base_model="${MODELS_DIR}/unsloth/Qwen3.8-Flash-Next-GGUF/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL.gguf";
  require_split_model "${base_model}" "unsloth/Qwen3.8-Flash-Next-GGUF" "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL.gguf" 4;
  
  local first_part="${base_model%.gguf}-00001-of-00004.gguf";

  exec "${LLAMA_SERVER}" \
    --model            "${first_part}" \
    --alias            jzaleski/experimental/boson \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8081"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       1024 \
    --ubatch-size      256 \
    --ctx-size         262144 \
    --cache-type-k     q8_0 \
    --cache-type-v     q8_0 \
    --spec-type        draft-mtp \
    --spec-draft-n-max 3 \
    --chat-template-kwargs '{"reasoning_effort":"xhigh"}' \
    --reasoning-preserve \
    --cache-reuse      256 \
    --cache-ram        -1 \
    --load-mode        mlock \
    --predict          262144 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

tier="default/medium";
for arg in "$@"; do
  case "${arg}" in
    --tier) ;;
    *)
      case "${prev_arg}" in
        --tier) tier="${arg}";;
      esac
      ;;
  esac
  prev_arg="${arg}";
done

case "${tier}" in
  default/low)               run_low;;
  default/medium)            run_medium;;
  default/high)              run_high;;
  default/low-multimodal)    run_low_multimodal;;
  default/medium-multimodal) run_medium_multimodal;;
  default/high-multimodal)   run_high_multimodal;;
  experimental/quark)        run_experimental_quark;;
  experimental/boson)        run_experimental_boson;;
  experimental)
    echo "Error: the 'experimental' tier has been removed. Use experimental/quark or experimental/boson." >&2;
    exit 1;;
  low|medium|high|low-multimodal|medium-multimodal|high-multimodal)
    echo "Error: standard tiers have moved to the default/ namespace (e.g. default/${tier})." >&2;
    exit 1;;
  *)
    echo "Error: unknown tier '${tier}'. Use: default/low, default/medium, default/high, default/low-multimodal, default/medium-multimodal, default/high-multimodal, experimental/quark, experimental/boson" >&2;
    exit 1;;
esac
