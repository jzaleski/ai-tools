#!/usr/bin/env bash

set -e;

MODELS_DIR="${MODELS_DIR:-"$HOME/.cache/models"}";

require_model() {
  local model_file="${1}";
  local hf_repo="${2}";
  # Optional third arg: HF path relative to repo root (e.g. subdir/file.gguf).
  # Falls back to basename of model_file for flat (non-split) models.
  local hf_filename="${3:-"$(basename "${model_file}")"}";
  if [[ ! -f "${model_file}" ]]; then
    echo "Model not found: ${model_file}";
    echo "Downloading ${hf_repo}/${hf_filename} -> ${model_file} ...";
    # Pass basename(model_file) as the explicit local filename so
    # download-model saves directly under the disambiguated local name (e.g.
    # a "-MTP-" infix) instead of the remote basename. This matters whenever
    # hf_filename differs from basename(model_file) — e.g. the MTP repo ships
    # files with the exact same names as the non-MTP repo, so without an
    # explicit local name download-model's existence check can't tell the two
    # repos' files apart and will wrongly skip a real download (and a
    # subsequent rename would silently mislabel the wrong repo's weights).
    "$(dirname "$0")/download-model" "${hf_repo}" "${hf_filename}" "$(basename "${model_file}")" || {
      echo "Error: download failed." >&2;
      exit 1;
    };
  fi
}

# Ensure the F16 multimodal projector for a model exists, downloading it if
# missing.  Derives the local mmproj path from the model file (same name with a
# .mmproj extension instead of .gguf) and pulls the repo's shared mmproj-F16.gguf.
# Args: <model-file> <hf-repo>
require_mmproj() {
  local model_file="${1}";
  local hf_repo="${2}";
  local mmproj_file="${model_file%.gguf}.mmproj";
  require_model "${mmproj_file}" "${hf_repo}" "mmproj-F16.gguf";
}

# Fast tiers (low/medium/high/long): unsloth's MTP (multi-token prediction)
# build of Qwen3.6-35B-A3B, run with llama.cpp's `--spec-type draft-mtp`
# speculative decoding for ~1.5-2x faster inference. llama.cpp does not yet
# support combining `--mmproj` with MTP speculative decoding, so these tiers
# are text-only (no vision).

run_low() {
  local model="${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf";
  require_model "${model}" "unsloth/Qwen3.6-35B-A3B-MTP-GGUF" "Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/low \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         32768 \
    --cache-type-k     q8_0 \
    --cache-type-v     q4_0 \
    --spec-type        draft-mtp \
    --spec-draft-n-max 2 \
    --reasoning-preserve \
    --predict          32768 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             0.6 \
    --top-k            20 \
    --top-p            0.95;
}

