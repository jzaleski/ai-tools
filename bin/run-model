  local model="${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-MTP-UD-Q6_K_XL.gguf";
  require_model "${model}" "unsloth/Qwen3.6-35B-A3B-MTP-GGUF" "Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf";
  exec llama-server \
    --model            "${model}" \
    --alias            jzaleski/medium \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         65536 \
    --cache-type-k     q8_0 \
    --cache-type-v     q4_0 \
    --spec-type        draft-mtp \
    --spec-draft-n-max 2 \
    --reasoning-preserve \
    --predict          32768 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             0.6 \
    --top-k            20 \
    --top-p            0.95;
}

