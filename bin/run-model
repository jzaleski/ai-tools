# Experimental tier: DeepSeek-V4-Flash-0731 with DSpark speculative decoding.
# Note on naming: "DSpark" is DeepSeek's proprietary speculative decoding algorithm
# (DeepSeek Spark), completely unrelated to Apache Spark. It functions similarly to
# MTP but is optimized for V4, yielding ~1.5x-2x faster inference.
# Context is intentionally kept at 256K for "Think High" reasoning. If experimenting
# with "Think Max" in the future (`reasoning_effort: max`), context should be
# bumped to at least 384K (393216) per Unsloth's recommendations.
run_experimental() {
  local base_model="${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-UD-Q8_K_XL.gguf";
  local drafter_model="${MODELS_DIR}/unsloth/DeepSeek-V4-Flash-0731-GGUF/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf";

  require_split_model "${base_model}" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "UD-Q8_K_XL/DeepSeek-V4-Flash-0731-UD-Q8_K_XL.gguf" 5;
  require_model "${drafter_model}" "unsloth/DeepSeek-V4-Flash-0731-GGUF" "dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf";

  local first_part="${base_model%.gguf}-00001-of-00005.gguf";

  exec llama-server \
    --model            "${first_part}" \
    --spec-draft-model "${drafter_model}" \
    --alias            jzaleski/experimental \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       1024 \
    --ubatch-size      256 \
    --ctx-size         262144 \
    --cache-type-k     q8_0 \
    --cache-type-v     q8_0 \
    --spec-type        draft-dspark \
    --spec-draft-n-max 3 \
    --chat-template-kwargs '{"reasoning_effort":"high"}' \
    --reasoning-preserve \
    --cache-reuse      256 \
    --cache-ram        -1 \
    --load-mode        mlock \
    --predict          262144 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             1.0 \
    --top-k            20 \
    --top-p            0.95;
}

tier="medium";
for arg in "$@"; do
  case "${arg}" in
    --tier) ;;
    *)
      case "${prev_arg}" in
        --tier) tier="${arg}";;
      esac
      ;;
  esac
  prev_arg="${arg}";
done

case "${tier}" in
  low)               run_low;;
  medium)            run_medium;;
  high)              run_high;;
  long)              run_long;;
  experimental)      run_experimental;;
  low-multimodal)    run_low_multimodal;;
  medium-multimodal) run_medium_multimodal;;
  high-multimodal)   run_high_multimodal;;
  long-multimodal)   run_long_multimodal;;
  *)
    echo "Error: unknown tier '${tier}'. Use: low, medium, high, long, experimental, low-multimodal, medium-multimodal, high-multimodal, long-multimodal" >&2;
    exit 1;;
esac
