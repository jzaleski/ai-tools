    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             0.6 \
    --top-k            20 \
    --top-p            0.95;
}

# Multimodal tiers (low-multimodal/medium-multimodal/high-multimodal/long-multimodal):
# unsloth's original (non-MTP) Qwen3.6-35B-A3B build, loaded with the shared
# F16 multimodal projector so image input works. No MTP speculative decoding.

run_low_multimodal() {
  local model="${MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf";
  local mmproj="${model%.gguf}.mmproj";
  require_model "${model}" "unsloth/Qwen3.6-35B-A3B-GGUF";
  require_mmproj "${model}" "unsloth/Qwen3.6-35B-A3B-GGUF";
  exec llama-server \
    --model            "${model}" \
    --mmproj           "${mmproj}" \
    --image-min-tokens 1024 \
    --alias            jzaleski/low-multimodal \
    --host             "${HOST:-"127.0.0.1"}" \
    --port             "${PORT:-"8080"}" \
    --flash-attn       on \
    --n-gpu-layers     -1 \
    --batch-size       2048 \
    --ubatch-size      512 \
    --ctx-size         32768 \
    --cache-type-k     q8_0 \
    --cache-type-v     q4_0 \
    --reasoning-preserve \
    --predict          32768 \
    --presence-penalty 0.0 \
    --repeat-penalty   1.0 \
    --min-p            0.0 \
    --temp             0.6 \
    --top-k            20 \
    --top-p            0.95;
}

run_medium_multimodal() {
