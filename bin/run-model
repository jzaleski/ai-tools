    --temp             0.6 \
    --top-k            20 \
    --top-p            0.95;
}

tier="medium";
for arg in "$@"; do
  case "${arg}" in
    --tier) ;;
    *)
      case "${prev_arg}" in
        --tier) tier="${arg}";;
      esac
      ;;
  esac
  prev_arg="${arg}";
done

case "${tier}" in
  low)               run_low;;
  medium)            run_medium;;
  high)              run_high;;
  long)              run_long;;
  low-multimodal)    run_low_multimodal;;
  medium-multimodal) run_medium_multimodal;;
  high-multimodal)   run_high_multimodal;;
  long-multimodal)   run_long_multimodal;;
  *)
    echo "Error: unknown tier '${tier}'. Use: low, medium, high, long, low-multimodal, medium-multimodal, high-multimodal, long-multimodal" >&2;
    exit 1;;
esac
