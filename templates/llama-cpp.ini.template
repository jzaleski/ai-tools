# Router preset config
# Keys use llama-server long-form flag names (no leading dashes).
# The [*] section supplies defaults inherited by every model section.
# Each named section becomes a routable model alias.
# Bind address is supplied by the launcher via --host (HOST env var); it is
# intentionally not set here.
#
# Two variants per tier:
#   - jzaleski/<tier>             fast/no-vision: run with spec-type draft-mtp speculative decoding.
#                                  llama.cpp does not yet support combining
#                                  mmproj with MTP speculative decoding, so
#                                  these sections omit mmproj.
#   - jzaleski/<tier>-multimodal  vision-capable: the same model weights but
#                                  without MTP enabled, plus the shared F16 multimodal projector.
#                                  No spec-type/spec-draft-n-max.

[*]
flash-attn         = on
n-gpu-layers       = -1
reasoning-preserve = 1
cache-reuse        = 256
cache-ram          = -1
load-mode          = mlock
predict            = 262144
presence-penalty   = 0.0
repeat-penalty     = 1.0
min-p              = 0.0
temp               = 1.0
top-k              = 20
top-p              = 0.95

[jzaleski/low]
model             = MODELS_DIR/unsloth/Qwen3.8-27B-UD-Q4_K_XL.gguf
ctx-size          = 65536
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0
spec-type         = draft-mtp
spec-draft-n-max  = 3
chat-template-kwargs = {"reasoning_effort":"low"}

[jzaleski/medium]
model             = MODELS_DIR/unsloth/Qwen3.8-27B-UD-Q6_K_XL.gguf
ctx-size          = 131072
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
spec-type         = draft-mtp
spec-draft-n-max  = 3
chat-template-kwargs = {"reasoning_effort":"medium"}

[jzaleski/high]
model             = MODELS_DIR/unsloth/Qwen3.8-27B-UD-Q8_K_XL.gguf
ctx-size          = 262144
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
spec-type         = draft-mtp
spec-draft-n-max  = 3
chat-template-kwargs = {"reasoning_effort":"high"}

[jzaleski/low-multimodal]
