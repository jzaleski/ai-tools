mmproj            = MODELS_DIR/unsloth/Qwen3.8-27B-UD-Q4_K_XL.mmproj
image-min-tokens  = 1024
ctx-size          = 65536
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0
chat-template-kwargs = {"reasoning_effort":"low"}

[jzaleski/medium-multimodal]
