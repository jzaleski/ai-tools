# Router preset config
# Keys use llama-server long-form flag names (no leading dashes).
# The [*] section supplies defaults inherited by every model section.
# Each named section becomes a routable model alias.
# Bind address is supplied by the launcher via --host (HOST env var); it is
# intentionally not set here.
#
# Two variants per tier:
#   - jzaleski/<tier>             fast/no-vision: unsloth's MTP build, run with
#                                  spec-type draft-mtp speculative decoding.
#                                  llama.cpp does not yet support combining
#                                  mmproj with MTP speculative decoding, so
#                                  these sections omit mmproj.
#   - jzaleski/<tier>-multimodal  vision-capable: unsloth's original (non-MTP)
#                                  build + the shared F16 multimodal projector.
#                                  No spec-type/spec-draft-n-max.
# long/long-multimodal are standalone-only (excluded here) — see
# bin/run-model --tier long / --tier long-multimodal.

[*]
flash-attn         = on
n-gpu-layers       = -1
reasoning-preserve = 1
cache-reuse        = 256
cache-ram          = -1
load-mode          = mlock
predict            = 32768
presence-penalty   = 0.0
repeat-penalty     = 1.0
min-p              = 0.0
temp               = 0.6
top-k              = 20
top-p              = 0.95

[jzaleski/low]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf
ctx-size          = 32768
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0
spec-type         = draft-mtp
spec-draft-n-max  = 2

[jzaleski/medium]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-MTP-UD-Q6_K_XL.gguf
ctx-size          = 65536
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0
spec-type         = draft-mtp
spec-draft-n-max  = 2

[jzaleski/high]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-MTP-UD-Q8_K_XL.gguf
ctx-size          = 131072
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
spec-type         = draft-mtp
spec-draft-n-max  = 2

[jzaleski/low-multimodal]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
mmproj            = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q4_K_XL.mmproj
image-min-tokens  = 1024
ctx-size          = 32768
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0

[jzaleski/medium-multimodal]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf
mmproj            = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q6_K_XL.mmproj
image-min-tokens  = 1024
ctx-size          = 65536
batch-size        = 2048
ubatch-size       = 512
cache-type-k      = q8_0
cache-type-v      = q4_0

[jzaleski/high-multimodal]
model             = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf
mmproj            = MODELS_DIR/unsloth/Qwen3.6-35B-A3B-UD-Q8_K_XL.mmproj
image-min-tokens  = 1024
ctx-size          = 131072
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
