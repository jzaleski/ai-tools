# Experimental Router preset config
# Keys use llama-server long-form flag names (no leading dashes).
# The [*] section supplies defaults inherited by every model section.
# Bind address is supplied by the launcher via --host (HOST env var).

[*]
flash-attn         = on
n-gpu-layers       = -1
reasoning-preserve = 1
cache-reuse        = 256
cache-ram          = -1
load-mode          = mlock
predict            = 262144
presence-penalty   = 0.0
repeat-penalty     = 1.0
min-p              = 0.0

[jzaleski/experimental/quark]
model             = MODELS_DIR/unsloth/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf
spec-draft-model  = MODELS_DIR/unsloth/DeepSeek-V4-Flash-0731-GGUF/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf
ctx-size          = 1048576
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
spec-type         = draft-dspark
spec-draft-n-max  = 3
chat-template-kwargs = {"reasoning_effort":"high"}
min-p             = 0.01
temp              = 1.0
top-p             = 0.95

[jzaleski/experimental/boson]
model             = MODELS_DIR/unsloth/Qwen3.8-Flash-Next-GGUF/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
ctx-size          = 262144
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
spec-type         = draft-mtp
spec-draft-n-max  = 3
chat-template-kwargs = {"reasoning_effort":"xhigh"}
temp              = 1.0
top-k             = 20
top-p             = 0.95
min-p             = 0.0
presence-penalty  = 0.0
repeat-penalty    = 1.0

# gluon: GLM-5.3-Flash, text-only. No speculative decoding yet (GLM-5.3-Flash
# support is still on an unmerged llama.cpp PR — see
# docs/specs/2026-08-29-gluon-glm-5.3-flash-experimental-tier-design.md). No
# top-k override — Unsloth's GLM-5.3-Flash examples never pass one.
[jzaleski/experimental/gluon]
model             = MODELS_DIR/unsloth/GLM-5.3-Flash-GGUF/UD-Q4_K_XL/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf
ctx-size          = 1048576
batch-size        = 1024
ubatch-size       = 256
cache-type-k      = q8_0
cache-type-v      = q8_0
chat-template-kwargs = {"reasoning_effort":"max"}
temp              = 1.0
top-p             = 0.95
min-p             = 0.0
presence-penalty  = 0.0
repeat-penalty    = 1.0
